# Optional: Google Search Console HTML-tag verification token.
# Copy only the content value from Google's meta tag, not the full <meta> element.
GOOGLE_SITE_VERIFICATION=

# Optional advertising/usage tracking is OFF by default. Set to true only in a consent-reviewed
# build when the campaign and its Google Ads measurements are deliberately reactivated.
# The value is read during Next.js rendering/build; rebuild and redeploy to change it.
GOOGLE_ADS_MEASUREMENT_ENABLED=false
